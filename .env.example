# Supabase — create a project at https://supabase.com
# Quick setup: run `bun run supabase:apply` with SUPABASE_DB_PASSWORD set (applies the complete chain through phase38),
# or paste supabase/FINAL_SETUP.sql into the SQL editor. Then `bun run supabase:verify` and `bun run supabase:rls`.
# Promote yourself: update public.profiles set role = 'admin' where id = '<your-user-uuid>';
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-jwt-key
# Optional newer publishable key (used if anon JWT is not set)
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: enable GitHub/Google OAuth in Supabase → Authentication → Providers
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# For `bun run supabase:apply` / `bun run supabase:seed` (never prefix with VITE_)
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Or use SUPABASE_DB_PASSWORD together with SUPABASE_PROJECT_REF:
# SUPABASE_PROJECT_REF=your-project-reference
# SUPABASE_DB_PASSWORD=your-database-password
# Optional trusted CA certificate path if required by your database endpoint:
# SUPABASE_DB_CA_FILE=/secure/path/prod-supabase-ca.crt
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email — serverless/edge endpoint (see api/email.ts and src/lib/email-handler.ts).
# Production requests authenticate with the signed-in Supabase session; never expose a server
# secret through a VITE_ variable.
# These receive member bearer tokens and must remain same-origin in production.
# VITE_EMAIL_ENDPOINT=/api/email
# VITE_ACCOUNT_DELETION_ENDPOINT=/api/account-deletion

# Server-side only (Vercel/Cloudflare secrets — never prefix with VITE_)
# BU1LD_SITE_ORIGIN=https://thebu1ld.com  # canonical origin used by server adapters
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_API_SECRET=optional-server-only automation secret; do not expose it to the client
# DIGEST_API_SECRET=random-secret-for-cron-digest-endpoint
# EMAIL_FROM=The Bu1ld <hello@thebu1ld.com>
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# EMAIL_ALLOW_UNAUTH_DEV=true  # local dev only — never set in production

# Optional privacy-respecting analytics (Plausible-style domain). Unset = no tracking.
# VITE_ANALYTICS_DOMAIN=thebu1ld.com
